# Repository-local toolchain and caches are reproducible with `python 02_Tools/setup.py`.
/02_Tools/runtime/
/02_Tools/cache/
__pycache__/

# Dependencies are restored by npm and never committed.
**/node_modules/

# Build output: TypeScript and Vite (dist/), electron-vite (out/), electron-builder working output (release_tmp/).
**/dist/
**/out/
**/release_tmp/
/05_Software/src/models/*
!/05_Software/src/models/model-manifest.json
/05_Software/src/windows_runtime/*
!/05_Software/src/windows_runtime/windows-runtime-manifest.json
/05_Software/src/uv/*
!/05_Software/src/uv/uv-manifest.json
# The official plugins as a catalog release, built by npm run prepare:plugins.
/05_Software/src/bundled-plugins/
*.tsbuildinfo

# Ignore explicitly requested coverage/reports and any legacy Playwright output.
**/coverage/
**/test-results/
**/playwright-report/
**/blob-report/

# Workbench runtime state (index, sessions, artifacts) that VERA creates when it opens a workbench,
# the demo fixture included.
**/.vera/
!/05_Software/tests/fixtures/workbenches/demo-board/.vera/

# Local Vite environment overrides are per-developer. Shared .env.<mode> files stay in Git.
**/.env.local
**/.env.*.local

# npm failure logs only: workbench fixtures contain *.log files that belong in Git.
npm-debug.log*

# Operating-system metadata.
.DS_Store
Thumbs.db
desktop.ini
# AEGIS:BEGIN (managed by .agentic/aegis.py init)
.agentic/tasks/*.anchor.json
.agentic/tasks/*.evolution.json
# AEGIS:END
