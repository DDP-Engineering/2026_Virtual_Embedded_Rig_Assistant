{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/tsc/tools",
    "tsBuildInfoFile": "node_modules/.cache/tsc/tools.tsbuildinfo",
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "vitest.config.ts",
    "tests/tooling/**/*.ts",
    "tests/integration/**/*.ts",
    "tests/packaging/**/*.ts",
    "playwright.config.ts",
    "tests/e2e/**/*.ts",
    "tests/network*.ts"
  ],
  "references": [
    {
      "path": "./src/libraries/core"
    },
    {
      "path": "./src/libraries/shared"
    }
  ]
}
