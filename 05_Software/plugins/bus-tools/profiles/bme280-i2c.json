{
  "name": "BME280 on I2C",
  "wiring": {
    "logicMv": 3300,
    "note": "SDA on IO0, SCL on IO1; the sensor board has its own 3.3 V supply"
  },
  "bus": { "mode": "i2c", "speedHz": 100000, "pullups": true },
  "devices": [
    {
      "name": "bme280",
      "address": "0x76",
      "registers": [
        { "name": "chip_id", "write": "d0", "expect": "60" },
        { "name": "status", "write": "f3" },
        { "name": "ctrl_hum", "write": "f2" },
        { "name": "ctrl_meas", "write": "f4", "note": "write 25 for one forced measurement, 1x oversampling" },
        { "name": "data", "write": "f7", "read": 8, "note": "pressure, temperature and humidity, raw" },
        { "name": "calibration", "write": "88", "read": 26 }
      ]
    }
  ]
}
