{
  "name": "W25Q SPI flash identification",
  "wiring": {
    "logicMv": 3300,
    "note": "CS, CLK, MOSI, MISO on the Bus Pirate's SPI pins; WP and HOLD tied high"
  },
  "bus": { "mode": "spi", "speedHz": 1000000, "cpol": 0, "cpha": 0 },
  "devices": [
    {
      "name": "flash",
      "registers": [
        { "name": "jedec_id", "write": "9f", "read": 3, "expect": "ef4018" },
        { "name": "status1", "write": "05" },
        { "name": "status2", "write": "35" }
      ]
    }
  ]
}
