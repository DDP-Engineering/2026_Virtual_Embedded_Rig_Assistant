{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/out",
      "!**/dist",
      "!**/release",
      "!**/coverage",
      "!**/test-results",
      "!**/playwright-report"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": { "noFloatingPromises": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["apps/desktop/src/renderer/**/*.css"],
      "css": { "parser": { "tailwindDirectives": true } }
    },
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "packages/core never imports electron (01 §1 L1); use a port from ports.ts.",
                  "react": "packages/core never imports react (01 §4)."
                },
                "patterns": [
                  {
                    "group": ["@vera/desktop*", "@vera/cli*", "**/apps/**"],
                    "message": "packages/core never imports apps/* (01 §4)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["electron", "react", "node:*", "@vera/core*", "@vera/desktop*", "@vera/cli*"],
                    "message": "packages/shared depends only on zod (01 §4)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/renderer/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["electron", "node:*", "@vera/core*", "**/packages/core/**"],
                    "message": "The renderer imports only @vera/shared and UI libraries; use window.vera (01 §1 L2, §4)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/preload/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@vera/core*", "**/packages/core/**", "react"],
                    "message": "The preload imports only @vera/shared and electron's contextBridge/ipcRenderer (01 §4)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
