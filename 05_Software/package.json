{
  "name": "vera",
  "private": true,
  "type": "module",
  "description": "VERA â€” Virtual Embedded Rig Assistant",
  "workspaces": [
    "src/libraries/*",
    "src/apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run check:i18n && npm run test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "dev": "electron-vite src/apps/desktop --entry src/apps/desktop --watch",
    "dev:renderer": "node scripts/dev-renderer.mjs",
    "build": "electron-vite build src/apps/desktop",
    "test:e2e": "node scripts/test-e2e.mjs",
    "perf:sessions": "node scripts/perf-sessions.mjs",
    "postinstall": "install-electron",
    "package": "node scripts/package.mjs",
    "package:test": "node scripts/package.mjs --test",
    "prepare:model": "node scripts/prepare-model.mjs",
    "prepare:uv": "node scripts/prepare-uv.mjs",
    "prepare:plugins": "node scripts/prepare-plugins.mjs",
    "prepare:windows-runtime": "node scripts/prepare-windows-runtime.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "make:demo-pdfs": "node scripts/make-demo-pdfs.mjs",
    "vera": "node scripts/build-cli.mjs && node src/apps/cli/dist/index.js",
    "eval:retrieval": "node scripts/eval-retrieval.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron/asar": "4.3.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.3",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "pdfkit": "0.20.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": false,
    "onnxruntime-node@1.30.0": false,
    "protobufjs@7.6.6": false,
    "electron-winstaller@5.4.0": false
  }
}
