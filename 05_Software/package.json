{
  "name": "vera",
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "description": "VERA — Virtual Embedded Rig Assistant",
  "workspaces": [
    "src/libraries/*",
    "src/apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "biome check . && biome check --vcs-enabled=false ../02_Tools/environment ../02_Tools/build ../02_Tools/release ../02_Tools/delivery",
    "format": "biome check --write . && biome check --write --vcs-enabled=false ../02_Tools/environment ../02_Tools/build ../02_Tools/release ../02_Tools/delivery",
    "typecheck": "tsc -b",
    "test": "vitest run --project \"!plugins\"",
    "test:coverage": "vitest run --coverage --project \"!plugins\"",
    "test:plugins": "vitest run --project plugins",
    "verify": "npm run lint && npm run typecheck && npm run check:i18n && npm run check:help && npm run check:release-notes && npm run test",
    "verify:all": "npm run verify && npm run test:plugins",
    "check:i18n": "node ../02_Tools/build/check-i18n.mjs",
    "check:help": "node ../02_Tools/build/check-help.mjs",
    "check:release-notes": "node ../02_Tools/build/check-release-notes.mjs",
    "help:shortcuts": "node ../02_Tools/build/generate-help-shortcuts.mjs",
    "dev": "electron-vite src/apps/desktop --entry src/apps/desktop --watch",
    "dev:renderer": "node ../02_Tools/environment/dev-renderer.mjs",
    "build": "electron-vite build src/apps/desktop",
    "test:e2e": "node tests/support/test-e2e.mjs",
    "postinstall": "install-electron",
    "package": "node ../02_Tools/release/package.mjs",
    "package:test": "node ../02_Tools/release/package.mjs --test",
    "prepare:model": "node ../02_Tools/environment/prepare-model.mjs",
    "prepare:uv": "node ../02_Tools/environment/prepare-uv.mjs",
    "prepare:plugins": "node ../02_Tools/environment/prepare-plugins.mjs",
    "prepare:windows-runtime": "node ../02_Tools/environment/prepare-windows-runtime.mjs",
    "delivery:vera": "node ../02_Tools/delivery/build-vera-installers.mjs",
    "delivery:plugins": "node ../02_Tools/delivery/build-plugin-packages.mjs",
    "delivery:plugin-deps": "node ../02_Tools/delivery/build-plugin-deps-kit.mjs",
    "delivery:components": "node ../02_Tools/delivery/build-components.mjs",
    "delivery:verify": "node ../02_Tools/delivery/verify-delivery.mjs",
    "smoke:live": "node ../02_Tools/release/smoke-live.mjs",
    "smoke:package": "node tests/packaging/smoke/smoke-package.mjs",
    "build:cli": "node ../02_Tools/build/build-cli.mjs",
    "make:demo-pdfs": "node tests/support/make-demo-pdfs.mjs",
    "vera": "node ../02_Tools/build/build-cli.mjs && node src/apps/cli/dist/index.js",
    "eval:models": "node evaluators/models/run.mjs",
    "eval:performance": "node evaluators/performance/run.mjs",
    "eval:compaction": "node evaluators/compaction/run.mjs",
    "eval:grounding": "node evaluators/grounding/run.mjs",
    "eval:retrieval": "node evaluators/retrieval/run.mjs",
    "eval:safety": "node evaluators/safety/run.mjs",
    "eval:routing": "node evaluators/routing/run.mjs",
    "eval:smoke": "node evaluators/smoke/run.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron/asar": "4.3.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.3",
    "electron": "44.11.4",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "pdfkit": "0.20.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.8",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": false,
    "onnxruntime-node@1.30.0": false,
    "protobufjs@7.6.6": false,
    "electron-winstaller@5.4.0": false
  }
}
