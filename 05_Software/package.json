{
  "name": "vera",
  "private": true,
  "type": "module",
  "description": "VERA — Virtual Embedded Rig Assistant",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
