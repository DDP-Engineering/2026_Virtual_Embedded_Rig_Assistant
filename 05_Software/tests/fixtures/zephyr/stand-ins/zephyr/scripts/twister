#!/usr/bin/env python3
"""Twister stand-in of the zephyr plugin tests: build-only results in twister.json and one ELF per scenario.

It reports the status fake.json names per scenario (default `not run`), so the tests can show that even a `passed`
build-only suite stays not-run in VERA's result. Settings come from fake.json beside the Zephyr base.
"""

import argparse
import json
import os
import sys
from pathlib import Path

base = Path(os.environ["ZEPHYR_BASE"])
root = base.parent
fake = json.loads((root / "fake.json").read_text(encoding="utf-8")) if (root / "fake.json").exists() else {}
parser = argparse.ArgumentParser()
parser.add_argument("--build-only", action="store_true")
parser.add_argument("-T")
parser.add_argument("-p")
parser.add_argument("-s", action="append", default=[])
parser.add_argument("--outdir")
parser.add_argument("--clobber-output", action="store_true")
parser.add_argument("-v", action="store_true")
parser.add_argument("--inline-logs", action="store_true")
parser.add_argument("-x", action="append", default=[])
args = parser.parse_args()
with open(root / "calls.jsonl", "a", encoding="utf-8") as handle:
    handle.write(json.dumps({"tool": "twister", "args": sys.argv[1:], "env": dict(os.environ)}) + "\n")
outdir = Path(args.outdir)
outdir.mkdir(parents=True, exist_ok=True)
suites = []
for scenario in args.s:
    folder = outdir / "stm32f4_disco_stm32f407xx" / "zephyr_gnu" / "tests" / scenario / "zephyr"
    folder.mkdir(parents=True, exist_ok=True)
    (folder / "zephyr.elf").write_bytes(Path(fake["elf"]).read_bytes() + scenario.encode())
    (folder / ".config").write_text("CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=168000000\n", encoding="utf-8")
    status = fake.get("status", {}).get(scenario, "not run")
    suites.append({"name": scenario, "platform": "stm32f4_disco/stm32f407xx", "status": status,
                   "testcases": [{"identifier": f"{scenario}.vera_basic.{case}", "status": status}
                                 for case in ("arithmetic", "optional", "expected")]})
(outdir / "twister.json").write_text(json.dumps({"environment": {}, "testsuites": suites}), encoding="utf-8")
print(f"INFO - {len(suites)} test scenarios built")
sys.exit(int(fake.get("twisterExit", 0)))
