{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "emitDeclarationOnly": true,
    "outDir": "../../../node_modules/.cache/tsc/desktop-renderer",
    "tsBuildInfoFile": "../../../node_modules/.cache/tsc/desktop-renderer.tsbuildinfo",
    "paths": {
      "@/*": ["./src/renderer/*"]
    }
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/renderer/**/*.json"],
  "references": [
    {
      "path": "../../libraries/shared"
    }
  ]
}
